{
  "manifest_version": 3,
  "name": "Phan V. Bang AI",
  "version": "2.0",
  "description": "Trợ lý AI thông minh - Tóm tắt, dịch thuật, phân tích và trả lời câu hỏi",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "inject-script": {
      "suggested_key": "Alt+Shift+Q",
      "description": "Mở trợ lý AI"
    }
  }
}
